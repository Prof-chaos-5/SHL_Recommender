# Primary Groq API Key
GROQ_API_KEY=gsk_your_key_here

# Optional: Multi-key rotation (highly recommended for evaluation runs)
GROQ_API_KEY_1=gsk_key1_here
GROQ_API_KEY_2=gsk_key2_here
GROQ_API_KEY_3=gsk_key3_here

# Catalog URL (Optional if local catalog.json is present)
CATALOG_URL=https://raw.githubusercontent.com/username/repo/main/catalog.json
